# ── Secrets ─────────────────────────────────────────────────────────
# Never commit the real .env. .env.sample is the template and IS committed.
.env
.env.local
*.pem
*.key

# ── Generated by the Flask UI ──────────────────────────────────────
# downloads/ holds PDFs and Anki decks produced by /export, plus any
# temporary wrong-QIDs CSVs created when "only my wrong questions" is
# ticked. Regenerated on demand; never check it in.
downloads/

# ── Benchmark / analysis output ────────────────────────────────────
# Anything generated by run_llm_test.py, draft_questions.py, the cost
# reports, or ad-hoc analysis. The .gitkeep below keeps the folder
# present but empty in the repo.
results/*
!results/.gitkeep

# Generated test-input JSON (built by generate_test_input.py from sqe1.db
# — reproducible, no need to track).
test_all.json
test_*.json

# Draft-queue JSON files written by draft_questions.py --output-file.
drafts*.json

# Anonymised CSVs exported for reproducibility — uncomment the lines below
# if you'd rather REGENERATE them per release instead of committing them.
# model_runs_anonymised.csv
# model_runs_summary.csv

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/

# ── Editors / IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Database temporaries ───────────────────────────────────────────
# sqe1.db ITSELF IS COMMITTED — it ships with the share.
# Ignore SQLite journals / locks / backups created at runtime.
*.db-journal
*.db-wal
*.db-shm
*.db.bak
*.sqlite-journal
